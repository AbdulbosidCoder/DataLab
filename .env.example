# Скопируйте в .env и вставьте свой ключ. Ключ хранится только здесь, в код и чат его не вставляйте.

# Какой STT использовать: xonsaroy (по умолчанию) или voicelab
STT_PROVIDER=xonsaroy

# Xonsaroy STT: ключ xs_stt_... из дашборда (Settings → API keys)
XONSAROY_API_KEY=xs_stt_...
# XONSAROY_BASE_URL=https://xonsaroy.adiz.uz/api/v1
# XONSAROY_MAX_CONCURRENT=2   # сервер принимает не больше 2 запросов одновременно

# Диаризация pyannote/speaker-diarization-3.1 (локально, делит людей перед Xonsaroy).
# Токен https://hf.co/settings/tokens; условия моделей speaker-diarization-3.1 и segmentation-3.0 должны быть приняты.
HF_TOKEN=hf_...
# DIARIZATION_DEVICE=auto   # auto (cuda, если есть) | cuda | cpu

# VoiceLab (https://voicelab.uz), если STT_PROVIDER=voicelab
VOICELAB_API_KEY=vlk_...

# Доступ из интернета (Cloudflare Tunnel). Без пароля студия открывается только на этом компьютере.
STUDIO_USER=admin
STUDIO_PASSWORD=
# Токен туннеля из Cloudflare Zero Trust (Networks → Tunnels → ваш туннель → токен после --token)
CLOUDFLARE_TUNNEL_TOKEN=
